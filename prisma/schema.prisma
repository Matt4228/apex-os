generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  scheduleBlocks  ScheduleBlock[]
  goals           Goal[]
  habits          Habit[]
  tasks           Task[]
  competitions    Competition[]
  participations  Participant[]
  friendsAsked    Friendship[] @relation("FriendRequester")
  friendsAnswered Friendship[] @relation("FriendAddressee")
  invitesSent     CompetitionInvite[] @relation("InvitesSent")
  invitesReceived CompetitionInvite[] @relation("InvitesReceived")
}

/// Two users who are friends, or a request from one to the other. One row per pair
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  /// "pending" or "accepted"
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// A block on the calendar: one day, or a series that repeats. src/lib/occurrences.ts turns it into dated blocks
model ScheduleBlock {
  id          String    @id @default(cuid())
  userId      String
  label       String
  category    String?
  /// Wall-clock "HH:MM"
  startTime   String
  endTime     String
  /// The first day it happens (a one-off's only day), stored as UTC midnight like other calendar dates
  startDate   DateTime
  /// "none", "daily", "weekday", "weekly" or "monthly"
  repeat      String    @default("none")
  /// Weekdays for "weekly": 0 is Sunday
  repeatDays  Int[]     @default([])
  /// Last possible day, inclusive. At most one of endsOn and endsAfter is set
  endsOn      DateTime?
  /// How many times it happens, counted from startDate
  endsAfter   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  exceptions  BlockException[]

  @@index([userId, startDate])
}

/// One day of a series that was cancelled, moved or changed
model BlockException {
  id         String        @id @default(cuid())
  blockId    String
  /// The day it would have happened
  date       DateTime
  cancelled  Boolean       @default(false)
  newDate    DateTime?
  startTime  String?
  endTime    String?
  label      String?
  category   String?

  block      ScheduleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, date])
  @@index([blockId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  status      String    @default("active")
  targetDate  DateTime?
  targetValue Float?
  unit        String?
  /// How logged numbers add up: "latest" (like a weight), "total" (like km run) or "best" (like a longest run)
  tracking    String    @default("latest")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     GoalEntry[]
  tasks       Task[]
}

model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  value     Float
  note      String?
  loggedOn  DateTime @default(now())
  createdAt DateTime @default(now())

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Habit {
  id            String   @id @default(cuid())
  userId        String
  title         String
  category      String?
  frequency     String   @default("daily")
  targetPerWeek Int      @default(7)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]
}

model HabitLog {
  id          String   @id @default(cuid())
  habitId     String
  completedOn DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  plannedFor  DateTime?
  scheduleBlockId String?

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  scheduleBlock ScheduleBlock? @relation(fields: [scheduleBlockId], references: [id], onDelete: SetNull)

  @@index([userId, plannedFor])
  @@index([scheduleBlockId])
}

/// A contest over a number of calendar weeks (Sunday to Saturday). src/lib/competition.ts does the scoring
model Competition {
  id          String   @id @default(cuid())
  /// The creator, who sets the weekly targets
  ownerId     String
  title       String
  category    String?
  /// Always a Sunday
  startDate   DateTime
  /// How many weeks it runs, 1 to 156 (three years)
  weeks       Int
  /// The code in its invite link, /join/CODE. Random, and the owner can reset it
  joinCode    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  metrics      CompetitionMetric[]
  participants Participant[]
  invites      CompetitionInvite[]

  @@index([ownerId])
}

/// A friend asked to join a competition. Accepting removes it and adds them as a participant
model CompetitionInvite {
  id            String   @id @default(cuid())
  competitionId String
  inviterId     String
  inviteeId     String
  /// "pending" or "declined"
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  inviter       User        @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee       User        @relation("InvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([competitionId, inviteeId])
  @@index([inviteeId])
}

/// Something measured each week, like "km run" or "workouts"
model CompetitionMetric {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  unit          String?
  sortOrder     Int      @default(0)

  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  targets       WeekTarget[]
  logs          ProgressLog[]

  @@index([competitionId])
}

/// A metric's target for one week, the same for every competitor
model WeekTarget {
  id        String   @id @default(cuid())
  metricId  String
  week      Int
  target    Float

  metric    CompetitionMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, week])
}

/// A user in a competition. Every log belongs to one, so more competitors can join without changing logs
model Participant {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  /// "owner" or "member"
  role          String   @default("member")
  joinedAt      DateTime @default(now())

  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          ProgressLog[]

  @@unique([competitionId, userId])
  @@index([userId])
}

/// Progress toward a metric in one week. Many per week; totals can pass the target
model ProgressLog {
  id            String   @id @default(cuid())
  participantId String
  metricId      String
  week          Int
  amount        Float
  note          String?
  createdAt     DateTime @default(now())

  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  metric        CompetitionMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([participantId, week])
  @@index([metricId])
}