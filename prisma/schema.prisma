generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  scheduleBlocks  ScheduleBlock[]
  goals           Goal[]
  habits          Habit[]
  tasks           Task[]
  competitions    Competition[]
}

/// A block on the calendar: one day, or a series that repeats. src/lib/occurrences.ts turns it into dated blocks
model ScheduleBlock {
  id          String    @id @default(cuid())
  userId      String
  label       String
  category    String?
  /// Wall-clock "HH:MM"
  startTime   String
  endTime     String
  /// The first day it happens (a one-off's only day), stored as UTC midnight like other calendar dates
  startDate   DateTime
  /// "none", "daily", "weekday", "weekly" or "monthly"
  repeat      String    @default("none")
  /// Weekdays for "weekly": 0 is Sunday
  repeatDays  Int[]     @default([])
  /// Last possible day, inclusive. At most one of endsOn and endsAfter is set
  endsOn      DateTime?
  /// How many times it happens, counted from startDate
  endsAfter   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  exceptions  BlockException[]

  @@index([userId, startDate])
}

/// One day of a series that was cancelled, moved or changed
model BlockException {
  id         String        @id @default(cuid())
  blockId    String
  /// The day it would have happened
  date       DateTime
  cancelled  Boolean       @default(false)
  newDate    DateTime?
  startTime  String?
  endTime    String?
  label      String?
  category   String?

  block      ScheduleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, date])
  @@index([blockId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  status      String    @default("active")
  targetDate  DateTime?
  targetValue Float?
  unit        String?
  /// How logged numbers add up: "latest" (like a weight), "total" (like km run) or "best" (like a longest run)
  tracking    String    @default("latest")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     GoalEntry[]
  tasks       Task[]
}

model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  value     Float
  note      String?
  loggedOn  DateTime @default(now())
  createdAt DateTime @default(now())

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Habit {
  id            String   @id @default(cuid())
  userId        String
  title         String
  category      String?
  frequency     String   @default("daily")
  targetPerWeek Int      @default(7)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]
}

model HabitLog {
  id          String   @id @default(cuid())
  habitId     String
  completedOn DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  plannedFor  DateTime?
  scheduleBlockId String?

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  scheduleBlock ScheduleBlock? @relation(fields: [scheduleBlockId], references: [id], onDelete: SetNull)

  @@index([userId, plannedFor])
  @@index([scheduleBlockId])
}

model Competition {
  id        String   @id @default(cuid())
  userId    String
  title     String
  rulesJson String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   CompetitionEntry[]
}

model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  weekNumber    Int
  value         Float
  metric        String
  weekComplete  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}